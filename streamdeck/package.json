{
  "name": "yc-onion-stream-deck-plugin",
  "version": "1.3.0",
  "private": true,
  "description": "Stream Deck plugin for controlling YC Onion Bluetooth devices.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirdaraee/yc-onion-stream-deck-plugin.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate com.amirdaraee.yc-onion.sdPlugin",
    "version:check": "node ../scripts/check-release-version.mjs",
    "check": "npm run version:check && npm run typecheck && npm run build && npm run validate",
    "pack": "streamdeck pack com.amirdaraee.yc-onion.sdPlugin --output dist --force",
    "release": "../scripts/build-plugin-release.sh"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.8.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.0.0",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  }
}
